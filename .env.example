# Your settings. The app's Setup page writes these for you; you can also edit this file. Never commit .env.

# ---- Models (agent/providers.py) -----------------------------------------------------------------------------
# The model writes everything that goes out under your name. The draft model (optional) does first passes over the
# many: ranking every posting, proposing fixes from your notes. Leave JHA_DRAFT_MODEL empty and the model does it all.
# Each is provider:name
#   anthropic:claude-opus-5-5     Claude API (needs ANTHROPIC_API_KEY)
#   claude-code                   your Claude Code login, no key (claude-code:<model> to pick one)
#   ollama:qwen3:32b              an open-source model on this computer (Ollama)
#   openai:Qwen/Qwen3-32B         any OpenAI-compatible server: vLLM, LM Studio, llama.cpp, OpenRouter (JHA_OPENAI_BASE_URL)
JHA_MODEL=
JHA_DRAFT_MODEL=
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
JHA_OPENAI_BASE_URL=
JHA_OPENAI_API_KEY=

# ---- Ranking (optional): Jev from TypeSafe rates every posting before a model reads it ------------------------
TYPESAFE_API_KEY=

# ---- Your application mailbox (optional, agent/mailbox.py): reads replies read-only, sends what you approve ---
# Gmail: turn on 2-Step Verification, then https://myaccount.google.com/apppasswords → create one, paste it here.
JHA_MAIL_APP_PASSWORD=
# JHA_MAIL_ADDRESS=          # defaults to the email in your standing answers
# JHA_IMAP_HOST= / JHA_SMTP_HOST=   # other providers

# ---- More job sources (optional, docs/03-job-sources-and-apis.md) ---------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
