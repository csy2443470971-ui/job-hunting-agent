# Copy to .env and fill in. Never commit .env.

# Model provider for every node (see agent/providers.py):
#   anthropic      Claude API (needs ANTHROPIC_API_KEY)
#   openai_compat  any OpenAI-compatible server: Ollama, vLLM, LM Studio, llama.cpp, OpenRouter
#   claude_code    your local `claude` CLI login, no API key
LLM_PROVIDER=anthropic
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:32b
LLM_API_KEY=
ANTHROPIC_API_KEY=
# Jev (TypeSafe System One): first-pass relevance scoring. Same key CodeCut uses.
TYPESAFE_API_KEY=

# Optional aggregators (see docs/03-job-sources-and-apis.md)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
# Models (defaults are fine)
MODEL_TAILOR=claude-opus-5-5
MODEL_SCORE=claude-opus-5-5

# Your application mailbox, connected directly (agent/mailbox.py): reads replies (read-only), sends approved emails.
# Gmail: turn on 2-Step Verification, then Google Account → Security → App passwords → create one and paste it here.
JHA_MAIL_APP_PASSWORD=
# JHA_MAIL_ADDRESS=      # defaults to the email in your standing answers
