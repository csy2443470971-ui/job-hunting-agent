template human  main title
```js
// The human check: a CAPTCHA box and an emailed code, both tagged "you".
(function () {
  var W = E.W, H = E.H, k = E.k;
  var title = E.knob('title', 'text', "That one's <em>yours</em>.", { label: 'Title' });
  var note = E.knob('note', 'text', 'The agent never solves CAPTCHAs or types your codes.', { label: 'Note' });
  var code = String(E.knob('code', 'text', 'K7Q2MX9B', { label: 'Example code' })).slice(0, 8);
  E.text('title', { text: title, x: .15, y: .2, w: .7, size: 88, align: 'center', start: .2, end: E.DUR, param: 'title' });
  E.text('note', { text: note, x: .15, y: .8, w: .7, size: 30, align: 'center', start: 2, end: E.DUR, param: 'note' });
  var tt = E.el('title', title), nn = E.el('sub', note);
  var c1 = E.el('', "<span style='font-size:" + (30 * k) + "px;font-weight:600'>I'm not a robot</span>");
  var c2 = E.el('', "<span style='font-size:" + (22 * k) + "px;color:var(--ink2);letter-spacing:.12em'>SECURITY CODE</span>");
  var you1 = E.el('', 'you'), you2 = E.el('', 'you');
  [you1, you2].forEach(function (y) { y.style.cssText += ';font-size:' + (20 * k) + 'px;font-weight:700;color:#fff;background:var(--accent2);padding:' + (4 * k) + 'px ' + (12 * k) + 'px;border-radius:999px'; });
  var letters = []; for (var i = 0; i < 8; i++) { var e = E.el('', code[i] || ''); e.style.cssText += ';font-size:' + (40 * k) + 'px;font-weight:600'; letters.push(e); }
  function card(x, y, w, h, a) { var g = E.g; g.save(); g.globalAlpha = a; g.shadowColor = 'rgba(60,40,20,.14)'; g.shadowBlur = 30 * k; g.shadowOffsetY = 12 * k;
    g.fillStyle = '#fff'; g.beginPath(); g.roundRect(x, y, w, h, 18 * k); g.fill(); g.restore(); }
  E.scene(function (t) {
    E.bgctx.fillStyle = E.C.bg; E.bgctx.fillRect(0, 0, E.W, E.H);
    var A = E.outro(t), g = E.g;
    E.place(tt, W / 2, H * .2, A * E.e(t, .2, .5), 'c', (1 - E.e(t, .2, .6)) * 22 * k);
    var a1 = A * E.e(t, .6, .5), a2 = A * E.e(t, 1.0, .5);
    var L = { x: W * .2, y: H * .38, w: W * .26, h: H * .24 }, R = { x: W * .52, y: H * .38, w: W * .3, h: H * .24 };
    card(L.x, L.y, L.w, L.h, a1); card(R.x, R.y, R.w, R.h, a2);
    // CAPTCHA
    var bx = L.x + 44 * k, by = L.y + L.h / 2 - 22 * k, tick = E.e(t, 2.3, .35);
    g.save(); g.globalAlpha = a1; g.strokeStyle = '#B9B2AA'; g.lineWidth = 3 * k; g.beginPath(); g.roundRect(bx, by, 44 * k, 44 * k, 6 * k); g.stroke();
    if (tick > 0) { g.strokeStyle = '#1E9E5A'; g.lineWidth = 6 * k; g.lineCap = 'round'; g.beginPath(); g.moveTo(bx + 10 * k, by + 23 * k);
      g.lineTo(bx + 10 * k + 9 * k * Math.min(1, tick * 2), by + 23 * k + 9 * k * Math.min(1, tick * 2));
      if (tick > .5) g.lineTo(bx + 19 * k + 16 * k * (tick - .5) * 2, by + 32 * k - 20 * k * (tick - .5) * 2); g.stroke(); }
    g.restore();
    E.place(c1, bx + 66 * k, by + 22 * k, a1, 'l');
    E.place(you1, L.x + L.w - 44 * k, L.y + 40 * k, A * E.e(t, 2.1, .3), 'c', (1 - E.e(t, 2.1, .4)) * 10 * k);
    // code boxes
    E.place(c2, R.x + 40 * k, R.y + 44 * k, a2, 'l');
    var bw = (R.w - 80 * k - 7 * 10 * k) / 8;
    for (var i = 0; i < 8; i++) {
      var x = R.x + 40 * k + i * (bw + 10 * k), y = R.y + 82 * k, on = E.e(t, 3.4 + i * .18, .2);
      g.save(); g.globalAlpha = a2; g.strokeStyle = on > 0 ? '#F27420' : '#D6D0C8'; g.lineWidth = 2.5 * k; g.beginPath(); g.roundRect(x, y, bw, 76 * k, 10 * k); g.stroke(); g.restore();
      E.place(letters[i], x + bw / 2, y + 38 * k, a2 * on, 'c');
    }
    E.place(you2, R.x + R.w - 44 * k, R.y + 40 * k, A * E.e(t, 3.2, .3), 'c', (1 - E.e(t, 3.2, .4)) * 10 * k);
    E.place(nn, W / 2, H * .8, A * E.e(t, 2, .6), 'c');
  });
})();
