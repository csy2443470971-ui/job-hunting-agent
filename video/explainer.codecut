template hook  main line1
```js
// The pain in two beats: a big line, then a second line while "Select…" dropdowns pile onto the page around it.
(function () {
  var W = E.W, H = E.H, k = E.k;
  var line1 = E.knob('line1', 'text', 'Applying for jobs is a <em>full-time job</em>.', { label: 'First line' });
  var line2 = E.knob('line2', 'text', "It doesn't pay. And it's <em>90% dropdowns</em>.", { label: 'Second line' });
  var beat = +E.knob('beat', 'number', 3.6, { min: 1, max: 6, step: .1, label: 'Second line at (s)' });
  E.text('line1', { text: line1, x: .12, y: .45, w: .76, size: 92, align: 'center', start: .2, end: beat, param: 'line1' });
  E.text('line2', { text: line2, x: .12, y: .45, w: .76, size: 92, align: 'center', start: beat, end: E.DUR, param: 'line2' });
  var a = E.el('title', ''), b = E.el('title', '');
  [a, b].forEach(function (e) { e.style.width = (W * .76) + 'px'; e.style.whiteSpace = 'normal'; });
  var wa = E.words(a, line1), wb = E.words(b, line2);
  var LABELS = ['Select…', 'Choose one…', 'Country ▾', 'Please select', 'Select…', 'Years of experience ▾', 'Select…', 'How did you hear? ▾',
                'Select…', 'Pronouns ▾', 'Choose…', 'Start date ▾', 'Select…', 'Visa status ▾', 'Select…', 'Relocate? ▾', 'Choose one…', 'Select…',
                'Degree ▾', 'Select…', 'Salary range ▾', 'Select…', 'Choose…', 'Select…'];
  var rnd = E.rng(7), pills = [];
  for (var i = 0; i < LABELS.length; i++) {
    var x, y, tries = 0;
    do { x = (.06 + rnd() * .88) * W; y = (.08 + rnd() * .74) * H; tries++; }   // clear of the caption strip
    while (tries < 400 && Math.abs(y - H * .45) < 190 * k);
    pills.push({ x: x, y: y, r: (rnd() - .5) * .35, t: beat + .15 + i * .07, label: LABELS[i] });
  }
  E.scene(function (t) {
    E.bgctx.fillStyle = E.C.bg; E.bgctx.fillRect(0, 0, E.W, E.H);
    var A = E.outro(t), g = E.g;
    var outA = 1 - E.e(t, beat - .35, .3, E.inCubic);
    wa.forEach(function (s, i) { var p = E.e(t, .15 + i * .07, .55); s.style.opacity = p; s.style.transform = 'translateY(' + ((1 - p) * 34 * k).toFixed(1) + 'px)'; });
    E.place(a, W / 2, H * .45, A * outA, 'c');
    wb.forEach(function (s, i) { var p = E.e(t, beat + i * .06, .5); s.style.opacity = p; s.style.transform = 'translateY(' + ((1 - p) * 34 * k).toFixed(1) + 'px)'; });
    E.place(b, W / 2, H * .45, A * E.e(t, beat, .2), 'c');
    g.save(); g.font = '500 ' + (22 * k) + 'px "Roobert TWHINT", Helvetica, sans-serif'; g.textBaseline = 'middle';
    pills.forEach(function (p) {
      var q = E.e(t, p.t, .7, E.outCubic); if (q <= 0) return;
      var up = p.y < H * .45;   // above the headline: fall from the top; below it: rise from the bottom (never across the words)
      var y = up ? p.y - (1 - q) * (p.y + 80 * k) : p.y + (1 - q) * (H - p.y + 80 * k), w = g.measureText(p.label).width + 64 * k, h = 48 * k;
      g.save(); g.globalAlpha = A * Math.min(1, q * 2) * .92; g.translate(p.x, y); g.rotate(p.r * q);
      g.shadowColor = 'rgba(40,30,20,.12)'; g.shadowBlur = 14 * k; g.shadowOffsetY = 6 * k;
      g.fillStyle = '#FFFFFF'; g.beginPath(); g.roundRect(-w / 2, -h / 2, w, h, 10 * k); g.fill();
      g.shadowColor = 'transparent'; g.strokeStyle = '#D6D0C8'; g.lineWidth = 1.5 * k; g.stroke();
      g.fillStyle = '#8A817A'; g.fillText(p.label.replace(' ▾', ''), -w / 2 + 18 * k, 1);
      g.fillStyle = '#B5ADA5'; g.fillText('▾', w / 2 - 30 * k, 1);
      g.restore();
    });
    g.restore();
  });
})();
```

template meet  main name
```js
// The app icon pops in, then the name and the one-line promise.
(function () {
  var W = E.W, H = E.H, k = E.k;
  var name = E.knob('name', 'text', 'Job Hunter <em>Agent</em>', { label: 'Name' });
  var sub = E.knob('sub', 'text', 'It does the boring part. You keep the part that matters.', { label: 'Line' });
  E.text('name', { text: name, x: .15, y: .62, w: .7, size: 96, align: 'center', start: .5, end: E.DUR, param: 'name' });
  E.text('sub', { text: sub, x: .15, y: .72, w: .7, size: 34, align: 'center', start: 1.0, end: E.DUR, param: 'sub' });
  var icon = E.el('', '<img src="data:image/webp;base64," style="width:' + (230 * k) + 'px;height:' + (230 * k) + 'px;display:block;filter:drop-shadow(0 ' + (18 * k) + 'px ' + (30 * k) + 'px rgba(80,40,20,.25))">');
  var t1 = E.el('title', name), t2 = E.el('sub', sub);
  t2.style.fontSize = (34 * k) + 'px';
  E.scene(function (t) {
    E.bgctx.fillStyle = E.C.bg; E.bgctx.fillRect(0, 0, E.W, E.H);
    var A = E.outro(t), p = E.seg(t, .1, .75);
    var s = p <= 0 ? .6 : 1 + Math.sin(p * Math.PI * 1.25) * .12 * (1 - p) - (1 - E.outCubic(p)) * .4;
    E.place(icon, W / 2, H * .36, A * E.e(t, .1, .3), 'c'); icon.style.transform += ' scale(' + s.toFixed(3) + ')';
    E.place(t1, W / 2, H * .62, A * E.e(t, .5, .5), 'c', (1 - E.e(t, .5, .6)) * 24 * k);
    E.place(t2, W / 2, H * .72, A * E.e(t, 1.0, .5), 'c', (1 - E.e(t, 1.0, .6)) * 18 * k);
  });
})();
