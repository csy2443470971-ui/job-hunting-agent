template step  main label
```js
// Step number and name in the left margin while a screen recording plays.
(function () {
  var W = E.W, H = E.H, k = E.k;
  var num = E.knob('num', 'text', '01', { label: 'Number' });
  var label = E.knob('label', 'text', 'Standing<br>answers', { label: 'Step' });
  E.text('label', { text: label, x: .03, y: .27, w: .12, size: 30, align: 'left', start: .3, end: E.DUR, param: 'label' });
  var n = E.el('', num), l = E.el('', label);
  n.style.cssText += ';font-size:' + (64 * k) + 'px;font-weight:700;letter-spacing:-.03em;color:var(--accent)';
  l.style.cssText += ';font-size:' + (30 * k) + 'px;font-weight:600;line-height:1.15;white-space:normal;width:' + (200 * k) + 'px;letter-spacing:-.01em';
  E.scene(function (t) {
    E.bgctx.fillStyle = E.C.bg; E.bgctx.fillRect(0, 0, E.W, E.H);
    var A = E.outro(t), x = 58 * k;
    E.place(n, x, 150 * k, A * E.e(t, 0, .45), 'l', 0);
    n.style.transform += ' translateX(' + ((1 - E.e(t, 0, .6)) * -30 * k).toFixed(1) + 'px)';
    E.rect(x, 196 * k, 46 * k * E.e(t, .15, .5, E.outExpo), 5 * k, 2.5 * k, E.C.accent2, A);
    E.place(l, x, 262 * k, A * E.e(t, .25, .45), 'l', (1 - E.e(t, .25, .55)) * 12 * k);
  });
})();
