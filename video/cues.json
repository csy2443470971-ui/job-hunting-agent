[
 {
  "start": 0.3,
  "end": 2.67,
  "text": "Job hunting is a full-time job."
 },
 {
  "start": 2.67,
  "end": 5.77,
  "text": "With zero pay, and way too many dropdowns."
 },
 {
  "start": 5.77,
  "end": 8.04,
  "text": "Meet Job Hunter Agent."
 },
 {
  "start": 8.04,
  "end": 10.44,
  "text": "Step one: dump everything on it."
 },
 {
  "start": 10.44,
  "end": 14.41,
  "text": "Old résumés, reference letters, that paper nobody read."
 },
 {
  "start": 14.41,
  "end": 16.23,
  "text": "Or just hit the mic and ramble."
 },
 {
  "start": 16.23,
  "end": 17.78,
  "text": "It's a great listener."
 },
 {
  "start": 17.78,
  "end": 19.24,
  "text": "It writes your story from that."
 },
 {
  "start": 19.24,
  "end": 20.12,
  "text": "True stuff only."
 },
 {
  "start": 20.48,
  "end": 22.43,
  "text": "No surprise PhD."
 },
 {
  "start": 22.43,
  "end": 26.02,
  "text": "Step two: it finds the roles and scores how well you fit."
 },
 {
  "start": 26.02,
  "end": 29.12,
  "text": "Goodbye, “entry level, ten years required.”"
 },
 {
  "start": 29.12,
  "end": 31.88,
  "text": "Step three: your résumé is tailored and the form is filled."
 },
 {
  "start": 32.15,
  "end": 34.52,
  "text": "Every single dropdown."
 },
 {
  "start": 34.52,
  "end": 37.09,
  "text": "Nothing goes out until you hit Approve."
 },
 {
  "start": 37.74,
  "end": 41.15,
  "text": "Then it watches your inbox and tells you who wrote back."
 },
 {
  "start": 41.15,
  "end": 42.46,
  "text": "Job Hunter Agent."
 },
 {
  "start": 42.46,
  "end": 43.5,
  "text": "It does the grind."
 },
 {
  "start": 43.5,
  "end": 44.9,
  "text": "You do the talking."
 }
]